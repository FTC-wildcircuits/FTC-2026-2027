<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchScreen.storyboard
  FTCTeamHub

  Branded splash: deep navy background, a large white SF Symbol badge
  (gearshape.2.fill, referenced as a system symbol — no image assets
  needed), team name, tagline, and a thin accent bar for polish.

  NOTE: iOS caches the launch screen snapshot per-install. If you rebuild
  and don't see this, fully delete the app from the simulator/device
  first, then reinstall.
-->
